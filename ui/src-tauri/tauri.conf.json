{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Needle",
  "version": "1.0.0",
  "identifier": "com.needle.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Needle",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources"],
    "category": "Productivity",
    "shortDescription": "Natural-language image retrieval",
    "longDescription": "Needle indexes your image folders and lets you find images with natural-language queries. Fully local: no accounts, no cloud required.",
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": [],
        "compression": {
          "type": "none"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {}
}
